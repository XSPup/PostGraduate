<mxfile host="app.diagrams.net" type="device" compressed="false"><diagram name="图2 获取与重算决策" id="图2 获取与重算决策"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="930" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="图2 获取与重算决策" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=1;shape=rectangle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1180" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="本文候选流程：比较未来剩余完成时间；正确性、内存与请求预算先于收益判断。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;shape=rectangle;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1180" height="40" as="geometry" /></mxCell><mxCell id="arrival" value="请求到达&#10;规范化 token 与执行标识" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eef5fc;strokeColor=#3870a3;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="485" y="110" width="270" height="75" as="geometry" /></mxCell><mxCell id="compatible" value="存在兼容的&#10;连续前缀缓存？" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff4e5;strokeColor=#ba7424;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="280" height="115" as="geometry" /></mxCell><mxCell id="ready" value="所需状态&#10;已经就绪？" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff4e5;strokeColor=#ba7424;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="480" y="395" width="280" height="110" as="geometry" /></mxCell><mxCell id="use" value="使用已就绪前缀&#10;计算剩余输入" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff8f2;strokeColor=#418761;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="925" y="405" width="260" height="90" as="geometry" /></mxCell><mxCell id="estimate" value="查询存储 / 合并有效在途加载&#10;估计排队、关键路径与等待预算" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4e5;strokeColor=#ba7424;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="550" width="400" height="80" as="geometry" /></mxCell><mxCell id="benefit" value="加载剩余完成时间&#10;加裕量 &lt; 重算？" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff4e5;strokeColor=#ba7424;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="465" y="675" width="310" height="110" as="geometry" /></mxCell><mxCell id="recompute" value="重新计算&#10;或使用已就绪部分后重算" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eef5fc;strokeColor=#3870a3;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="45" y="682" width="300" height="95" as="geometry" /></mxCell><mxCell id="load" value="按预算加载并恢复&#10;验证、发布后继续推理" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4e5;strokeColor=#ba7424;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920" y="682" width="300" height="95" as="geometry" /></mxCell><mxCell