        <mxCell id="title" value="端侧 HiCache 适配：读缓存还是重新计算？" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="20" width="700" height="42" as="geometry" /></mxCell>
