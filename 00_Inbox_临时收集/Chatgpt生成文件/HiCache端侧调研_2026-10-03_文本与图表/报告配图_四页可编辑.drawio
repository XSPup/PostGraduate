        <mxCell id="e5" value="读写 KV" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;fontFamily=Microsoft YaHei;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="compute" target="ram"><mxGeometry relative="1" as="geometry" /></mxCell>
