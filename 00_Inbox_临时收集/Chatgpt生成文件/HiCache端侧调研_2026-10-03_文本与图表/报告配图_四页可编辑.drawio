        <mxCell id="scene" value="无独立 GPU 的工控机：CPU 推理；模型权重、当前 KV 与历史 KV 争用同一 RAM" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="65" y="92" width="955" height="30" as="geometry" /></mxCell>
        <mxCell id="request" value="再次提问&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;同一设备手册前缀&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=17;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="170" height="85" as="geometry" /></mxCell>
        <mxCell id="decision" value="Radix 前缀索引与调度&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;热缓存直接用；冷缓存比较读与算&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=17;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="260" height="85" as="geometry" /></mxCell>
        <mxCell id="compute" value="CPU 推理&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;复用已就绪 KV 或重算前缀&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=17;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="220" height="85" as="geometry" /></mxCell>
