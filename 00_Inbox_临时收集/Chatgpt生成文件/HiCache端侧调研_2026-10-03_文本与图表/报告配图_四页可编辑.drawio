8;fontStyle=0;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="480" y="395" width="280" height="110" as="geometry" /></mxCell><mxCell id="use" value="使用已就绪前缀&#10;计算剩余输入" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff8f2;strokeColor=#418761;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="925" y="405" width="260" height="90" as="geometry" /></mxCell><mxCell id="estimate" value="查询存储 / 合并有效在途加载&#10;估计排队、关键路径与等待预算" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4e5;strokeColor=#ba7424;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="550" width="400" height="80" as="geometry" /></mxCell><mxCell id="benefit" value="加载剩余完成时间&#10;加裕量 &lt; 重算？" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff4e5;strokeColor=#ba7424;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="465" y="675" width="310" height="110" as="geometry" /></mxCell><mxCell id="recompute" value="重新计算&#10;或使用已就绪部分后重算" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eef5fc;strokeColor=#3870a3;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="45" y="682" width="300" height="95" as="geometry" /></mxCell><mxCell id="load" value="按预算加载并恢复&#10;验证、发布后继续推理" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4e5;strokeColor=#ba7424;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1c2e42;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920" y="682" width="300" height="95" as="geometry" /></mxCell><mxCell id="done" value="首 token 输出；记录实际成本与误差" style="rounde