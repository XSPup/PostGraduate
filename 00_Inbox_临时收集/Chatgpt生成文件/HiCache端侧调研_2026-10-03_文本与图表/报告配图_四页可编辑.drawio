        <mxCell id="storage" value="本地存储：冷前缀 KV&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;只保存预计值得复用的前缀&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="ram" value="有限 RAM：活动 KV&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;与模型权重、当前请求共享空间&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="330" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="outcome" value="热命中：复用　｜　仅冷命中：读取与重算择快　｜　未命中：重算　｜　后台写入限速" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="950" height="36" as="geometry" /></mxCell>
